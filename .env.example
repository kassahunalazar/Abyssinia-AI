ASSISTANT_MODEL_URL=http://127.0.0.1:20128/v1
ASSISTANT_MODEL_ID=kc/openrouter/free
ASSISTANT_MODEL_KEY=

# Optional backend key for Gemini speech evaluation. Playback requires a native-speaker review.
ABYSSINIA_TTS_KEY=

# Start an already-installed local OmniRoute service when a chat requests it.
ABYSSINIA_START_OMNIROUTE=1

# Optional Linux container image already installed in local Docker.
ASSISTANT_PROJECT_CONTAINER_IMAGE=
